<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>org.kmonad.kmonad</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/cleaver/.local/bin/kmonad</string>
      <string>/Users/cleaver/.config/kmonad/aaapl-config.kbd</string>
    </array>
    <key>UserName</key>
    <string>root</string>
    <key>WorkingDirectory</key>
    <string>/Users/cleaver</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/var/log/kmonad.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/kmonad.log</string>
  </dict>
</plist>
